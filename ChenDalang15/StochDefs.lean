noncomputable section

namespace ChenDalang15.Stoch

open MeasureTheory ProbabilityTheory Set
open scoped ENNReal NNReal

/-- Lebesgue measure on time-space with time restricted to `(0, ∞)` (copy of
`WalshIntegral.WhiteNoise.timeSpaceVolume`). -/
def timeSpaceVolume : Measure (ℝ × ℝ) := (volume.restrict (Ioi (0 : ℝ))).prod volume

/-- The Hilbert space `L²((0,∞) × ℝ)` of deterministic integrands. -/
abbrev H := Lp ℝ 2 timeSpaceVolume

/-- Essential support in `(0,t] × ℝ`. -/
def SupportedBefore (t : ℝ≥0) (h : H) : Prop :=
  ∀ᵐ z ∂timeSpaceVolume, (t : ℝ) < z.1 → h z = 0

/-- Essential support in `(s,∞) × ℝ`. -/
def SupportedAfter (s : ℝ≥0) (h : H) : Prop :=
  ∀ᵐ z ∂timeSpaceVolume, z.1 ≤ (s : ℝ) → h z = 0

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}

/-- The σ-field generated by the noise after time `s`. -/
@[instance_reducible]
def futureSigma (W : H →L[ℝ] Lp ℝ 2 P) (s : ℝ≥0) : MeasurableSpace Ω :=
  ⨆ h : {h : H // SupportedAfter s h},
    MeasurableSpace.comap (fun ω => W h.val ω) inferInstance

/-- The raw natural σ-field of the noise up to time `t`: generated by `W h` for `h` essentially
supported in `(0,t] × ℝ` (paper: `σ(W_s(A), 0 ≤ s ≤ t, A ∈ 𝓑_b(ℝ))`). -/
@[instance_reducible]
def pastSigma (W : H →L[ℝ] Lp ℝ 2 P) (t : ℝ≥0) : MeasurableSpace Ω :=
  ⨆ h : {h : H // SupportedBefore t h},
    MeasurableSpace.comap (fun ω => W h.val ω) inferInstance

/-- `F` is the natural filtration of `W` augmented by the null sets: an ambient measurable event
lies in `F t` iff it agrees a.s. with an event of `pastSigma W t` (copy of
`WalshIntegral.WhiteNoise.IsCompletedNatural`). On a complete probability space this is
`σ(W_s(A), s ≤ t) ∨ 𝓝`, the paper's `𝓕ₜ`. -/
def IsCompletedNatural (P : Measure Ω) (F : Filtration ℝ≥0 mΩ)
    (W : H →L[ℝ] Lp ℝ 2 P) : Prop :=
  ∀ t S, MeasurableSet[F t] S ↔
    MeasurableSet S ∧ ∃ B, MeasurableSet[pastSigma W t] B ∧ S =ᵐ[P] B

/-- Space-time white noise relative to the filtration `F` (copy of
`WalshIntegral.WhiteNoise.IsWhiteNoise`): an isometric, centred Gaussian, `F`-adapted family
`W h`, `h ∈ L²((0,∞) × ℝ)`, whose future is independent of `F s`. -/
structure IsWhiteNoise (P : Measure Ω) [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) (W : H →L[ℝ] Lp ℝ 2 P) : Prop where
  isometry : Isometry W
  gaussian : ∀ h : H, P.map (fun ω => W h ω) = gaussianReal 0 (‖h‖₊ ^ 2)
  adapted : ∀ (t : ℝ≥0) (h : H), SupportedBefore t h →
    ∃ X : Ω → ℝ, StronglyMeasurable[F t] X ∧ X =ᵐ[P] (fun ω => W h ω)
  future_independent : ∀ s : ℝ≥0, Indep (futureSigma W s) (F s) P

/-- The paper's probability setting (Section 2.2): a white noise `W` on a complete probability
space, with `F` its natural filtration augmented by the null sets (augmented natural filtration). -/
structure IsAugmentedWhiteNoise (P : Measure Ω) [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) (W : H →L[ℝ] Lp ℝ 2 P) : Prop where
  complete : P.IsComplete
  whiteNoise : IsWhiteNoise P F W
  completedNatural : IsCompletedNatural P F W

/-- The predictable σ-field on `ℝ × ℝ × Ω` (copy of `WalshIntegral.Predictable.predictableSigma`),
generated by `(s,t] × A × B` with `B ∈ F s` and by `C × A × B` with `C ⊆ (−∞,0]`, `B ∈ F 0`. -/
@[instance_reducible]
def predictableSigma (F : Filtration ℝ≥0 mΩ) : MeasurableSpace (ℝ × ℝ × Ω) :=
  MeasurableSpace.generateFrom {S |
    (∃ (s t : ℝ≥0) (A : Set ℝ) (B : Set Ω),
      s < t ∧ MeasurableSet A ∧ MeasurableSet[F s] B ∧
        S = Ioc (s : ℝ) (t : ℝ) ×ˢ (A ×ˢ B)) ∨
    (∃ (C A : Set ℝ) (B : Set Ω),
      MeasurableSet C ∧ C ⊆ Iic 0 ∧ MeasurableSet A ∧ MeasurableSet[F 0] B ∧
        S = C ×ˢ (A ×ˢ B))}

/-- `ds dy dP` with `s > 0`. -/
def spaceTimeSample (P : Measure Ω) : Measure (ℝ × ℝ × Ω) :=
  (volume.restrict (Ioi (0 : ℝ))).prod (volume.prod P)

/-- Predictable classes in `L²(ds dy dP)`. -/
abbrev predL2Submodule (F : Filtration ℝ≥0 mΩ) (P : Measure Ω) :
    Submodule ℝ (Lp ℝ 2 (spaceTimeSample P)) :=
  lpMeas ℝ ℝ (predictableSigma F) 2 (spaceTimeSample P)

/-- The paper's `𝒫₂` (Section 3.1): predictable square-integrable integrands. -/
abbrev PredL2 (F : Filtration ℝ≥0 mΩ) (P : Measure Ω) := ↥(predL2Submodule F P)

/-- `J` is the Walsh integral against `W`: a continuous linear map on `𝒫₂` that sends every
elementary integrand `c(ω) 1_{(s,t]}(r) 1_A(y)` (`c` bounded and `F s`-measurable, `A` of finite
measure) to `c · W(1_{(s,t] × A})`. -/
def IsWalshIntegral [IsProbabilityMeasure P] {F : Filtration ℝ≥0 mΩ}
    (W : H →L[ℝ] Lp ℝ 2 P) (J : PredL2 F P →L[ℝ] Lp ℝ 2 P) : Prop :=
  ∀ (s t : ℝ≥0) (A : Set ℝ) (c : Ω → ℝ), s < t → MeasurableSet A → volume A ≠ ∞ →
    Measurable[F s] c → (∃ C : ℝ, ∀ ω, |c ω| ≤ C) →
    ∀ (g : PredL2 F P) (r : H),
      (fun q => (g : Lp ℝ 2 (spaceTimeSample P)) q) =ᵐ[spaceTimeSample P]
        (fun q => c q.2.2 * (Ioc (s : ℝ) t ×ˢ A).indicator (fun _ => (1 : ℝ)) (q.1, q.2.1)) →
      (fun z => r z) =ᵐ[timeSpaceVolume] (Ioc (s : ℝ) t ×ˢ A).indicator (fun _ => (1 : ℝ)) →
      (fun ω => J g ω) =ᵐ[P] fun ω => c ω * W r ω

/-- `I` is the stochastic integral field of `u` (paper, display after `E2:WalshSI`): for every
`t > 0` and `x`, the integrand `(s,y,ω) ↦ G_ν(t−s, x−y) ρ(u(s,y,ω))` has a class `g` in `𝒫₂`
and `I(t,x) = J g`. -/
def IsIntegralField [IsProbabilityMeasure P] {F : Filtration ℝ≥0 mΩ}
    (J : PredL2 F P →L[ℝ] Lp ℝ 2 P) (ν : ℝ) (ρ : ℝ → ℝ) (u : ℝ → ℝ → Ω → ℝ)
    (I : ℝ → ℝ → Lp ℝ 2 P) : Prop :=
  ∀ t : ℝ, 0 < t → ∀ x : ℝ, ∃ g : PredL2 F P,
    (fun q => (g : Lp ℝ 2 (spaceTimeSample P)) q) =ᵐ[spaceTimeSample P]
      (fun q => G ν (t - q.1) (x - q.2.1) * ρ (u q.1 q.2.1 q.2.2)) ∧ I t x = J g

/-- Random field solution of `u = J₀ + ∬ G_ν(t−s,x−y) ρ(u(s,y)) W(ds,dy)` (paper, Definition
`D2:Solution`); see the module docstring for the clause-by-clause comparison. -/
structure IsRandomFieldSolution [IsProbabilityMeasure P] {F : Filtration ℝ≥0 mΩ}
    (J : PredL2 F P →L[ℝ] Lp ℝ 2 P) (ν : ℝ) (ρ : ℝ → ℝ) (μ : Measure ℝ)
    (u : ℝ → ℝ → Ω → ℝ) : Prop where
  /-- `D2:Solution(1)`. -/
  adapted : ∀ t : ℝ, 0 < t → ∀ x : ℝ, Measurable[F t.toNNReal] (u t x)
  /-- `D2:Solution(2)`. -/
  jointlyMeasurable : Measurable (fun q : Ioi (0 : ℝ) × ℝ × Ω => u q.1 q.2.1 q.2.2)
  /-- `D2:Solution(3)`, first half. -/
  finite : ∀ t : ℝ, 0 < t → ∀ x : ℝ,
    ∫⁻ z in Ioo 0 t ×ˢ univ, ENNReal.ofReal (G ν (t - z.1) (x - z.2) ^ 2) *
      momentFn P (fun s y ω => ρ (u s y ω)) 2 z.1 z.2 < ∞
  /-- `D2:Solution(3)`, second half, and `D2:Solution(4)`. -/
  integral : ∃ I : ℝ → ℝ → Lp ℝ 2 P, IsIntegralField J ν ρ u I ∧
    ContinuousOn (fun z : ℝ × ℝ => I z.1 z.2) (Ioi 0 ×ˢ univ) ∧
    ∀ t : ℝ, 0 < t → ∀ x : ℝ, u t x =ᵐ[P] fun ω => J0 ν μ t x + I t x ω

end ChenDalang15.Stoch

end

-- END SHARED DEFINITIONS: StochDefs

/-! ## Fidelity fixtures

Not part of the shared block. They check that the predicate is neither vacuous nor too weak:

* `isRandomFieldSolution_rho_zero`: with `ρ = 0` the deterministic field `J₀` is a solution, for
  every continuous linear `J` (satisfiability in a degenerate case);
* `ae_eq_J0_of_rho_zero`, `momentFn_of_rho_zero`: with `ρ = 0` every solution is a.s. `J₀`, so
  its second moment is `J₀²`; `not_isRandomFieldSolution_J0_add_one`: `J₀ + 1` is rejected;
* `notAdapted_otherClauses`, `not_isRandomFieldSolution_notAdapted`: on a two-point space with a
  trivial (non-augmented) filtration, a null-set modification of the solution `0` satisfies every
  clause except adaptedness and is rejected: the literal adaptedness clause is load-bearing.
-/

noncomputable section

namespace ChenDalang15.Stoch

open MeasureTheory ProbabilityTheory Set
open scoped ENNReal NNReal

theorem measurable_J0_uncurry (ν : ℝ) (μ : Measure ℝ) [SFinite μ] :
    Measurable (fun p : ℝ × ℝ => J0 ν μ p.1 p.2) := by
  have hG : StronglyMeasurable
      (Function.uncurry fun (p : ℝ × ℝ) (y : ℝ) => G ν p.1 (p.2 - y)) := by
    apply Measurable.stronglyMeasurable
    unfold G
    fun_prop
  exact (hG.integral_prod_right (ν := μ)).measurable

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}

/-- With `ρ = 0` every integral field is zero. -/
theorem integralField_rho_zero [IsProbabilityMeasure P] {F : Filtration ℝ≥0 mΩ}
    {J : PredL2 F P →L[ℝ] Lp ℝ 2 P} {ν : ℝ} {u : ℝ → ℝ → Ω → ℝ} {I : ℝ → ℝ → Lp ℝ 2 P}
    (hI : IsIntegralField J ν (fun _ => 0) u I) {t : ℝ} (ht : 0 < t) (x : ℝ) : I t x = 0 := by
  obtain ⟨g, hg, hIg⟩ := hI t ht x
  have hg0 : g = 0 := by
    apply Subtype.ext
    apply Lp.ext
    refine hg.trans ?_
    simp only [mul_zero]
    exact (Lp.coeFn_zero ℝ 2 (spaceTimeSample P)).symm
  rw [hIg, hg0, map_zero]

/-- Satisfiability: with `ρ = 0`, `u = J₀` is a random field solution, for every `J`. -/
theorem isRandomFieldSolution_rho_zero [IsProbabilityMeasure P] {F : Filtration ℝ≥0 mΩ}
    (J : PredL2 F P →L[ℝ] Lp ℝ 2 P) (ν : ℝ) (μ : Measure ℝ) [SFinite μ] :
    IsRandomFieldSolution J ν (fun _ => 0) μ (fun t x _ => J0 ν μ t x) where
  adapted _ _ _ := measurable_const
  jointlyMeasurable :=
    (measurable_J0_uncurry ν μ).comp
      ((measurable_subtype_coe.comp measurable_fst).prodMk (measurable_fst.comp measurable_snd))
  finite t _ x := by simp [momentFn]
  integral := by
    refine ⟨fun _ _ => 0, fun t _ x => ⟨0, ?_, by simp⟩, continuousOn_const, fun t _ x => ?_⟩
    · simp only [mul_zero]
      exact Lp.coeFn_zero ℝ 2 (spaceTimeSample P)
    · filter_upwards [Lp.coeFn_zero ℝ 2 P] with ω hω
      simp

/-- Uniqueness in the degenerate case: with `ρ = 0` every solution is a.s. `J₀`. -/
theorem ae_eq_J0_of_rho_zero [IsProbabilityMeasure P] {F : Filtration ℝ≥0 mΩ}
    {J : PredL2 F P →L[ℝ] Lp ℝ 2 P} {ν : ℝ} {μ : Measure ℝ} {u : ℝ → ℝ → Ω → ℝ}
    (hu : IsRandomFieldSolution J ν (fun _ => 0) μ u) {t : ℝ} (ht : 0 < t) (x : ℝ) :
    u t x =ᵐ[P] fun _ => J0 ν μ t x := by
  obtain ⟨I, hI, -, heq⟩ := hu.integral
  have h0 := integralField_rho_zero hI ht x
  filter_upwards [heq t ht x, Lp.coeFn_zero ℝ 2 P] with ω h1 h2
  rw [h1, h0, h2]
  simp

/-- The second moment in the degenerate case: `E|u(t,x)|² = J₀(t,x)²`. -/
theorem momentFn_of_rho_zero [IsProbabilityMeasure P] {F : Filtration ℝ≥0 mΩ}
    {J : PredL2 F P →L[ℝ] Lp ℝ 2 P} {ν : ℝ} {μ : Measure ℝ} {u : ℝ → ℝ → Ω → ℝ}
    (hu : IsRandomFieldSolution J ν (fun _ => 0) μ u) {t : ℝ} (ht : 0 < t) (x : ℝ) :
    momentFn P u 2 t x = ENNReal.ofReal (J0 ν μ t x ^ 2) := by
  unfold momentFn
  rw [lintegral_congr_ae ((ae_eq_J0_of_rho_zero hu ht x).mono fun ω h => by rw [h]),
    lintegral_const, measure_univ, mul_one, Real.enorm_eq_ofReal_abs,
    ENNReal.ofReal_rpow_of_nonneg (abs_nonneg _) (by norm_num)]
  congr 1
  rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast, sq_abs]

/-- Negative fixture: with `ρ = 0`, the adapted, jointly measurable field `J₀ + 1` is not a
solution (the equation clause bites). -/
theorem not_isRandomFieldSolution_J0_add_one [IsProbabilityMeasure P] {F : Filtration ℝ≥0 mΩ}
    (J : PredL2 F P →L[ℝ] Lp ℝ 2 P) (ν : ℝ) (μ : Measure ℝ) :
    ¬ IsRandomFieldSolution J ν (fun _ => 0) μ (fun t x _ => J0 ν μ t x + 1) := by
  intro hu
  obtain ⟨ω, hω⟩ := (ae_eq_J0_of_rho_zero hu one_pos 0).exists
  simp at hω

/-! ### A non-adapted modification on a two-point space -/

/-- The trivial filtration `F t = ⊥` on `Bool`; it is not augmented by the null sets of
`dirac true`. -/
def trivialFiltration : Filtration ℝ≥0 (inferInstance : MeasurableSpace Bool) :=
  Filtration.const ℝ≥0 ⊥ bot_le

/-- The field `u(t,x)(ω) = 0` for `ω = true` and `1` for `ω = false`: a null-set modification of
`0` under `dirac true`, not measurable for the trivial σ-field. -/
def notAdaptedField : ℝ → ℝ → Bool → ℝ := fun _ _ ω => cond ω 0 1

/-- `notAdaptedField` satisfies clauses (2), (3) and (4) of `D2:Solution` (with `ρ = 0`, `μ = 0`,
`J = 0`). -/
theorem notAdapted_otherClauses :
    Measurable (fun q : Ioi (0 : ℝ) × ℝ × Bool => notAdaptedField q.1 q.2.1 q.2.2) ∧
    (∀ t : ℝ, 0 < t → ∀ x : ℝ,
      ∫⁻ z in Ioo 0 t ×ˢ univ, ENNReal.ofReal (G 1 (t - z.1) (x - z.2) ^ 2) *
        momentFn (Measure.dirac true) (fun s y ω => (fun _ : ℝ => (0 : ℝ)) (notAdaptedField s y ω))
          2 z.1 z.2 < ∞) ∧
    ∃ I : ℝ → ℝ → Lp ℝ 2 (Measure.dirac true),
      IsIntegralField (F := trivialFiltration)
        (0 : PredL2 trivialFiltration (Measure.dirac true) →L[ℝ] Lp ℝ 2 (Measure.dirac true))
        1 (fun _ => 0) notAdaptedField I ∧
      ContinuousOn (fun z : ℝ × ℝ => I z.1 z.2) (Ioi 0 ×ˢ univ) ∧
      ∀ t : ℝ, 0 < t → ∀ x : ℝ,
        notAdaptedField t x =ᵐ[Measure.dirac true] fun ω => J0 1 0 t x + I t x ω := by
  have hsol := isRandomFieldSolution_rho_zero (F := trivialFiltration)
    (0 : PredL2 trivialFiltration (Measure.dirac true) →L[ℝ] Lp ℝ 2 (Measure.dirac true))
    1 (0 : Measure ℝ)
  refine ⟨Measurable.comp (g := fun ω : Bool => cond ω (0 : ℝ) 1) measurable_from_top
    (measurable_snd.comp measurable_snd), ?_, ?_⟩
  · intro t _ x
    simp [momentFn]
  · obtain ⟨I, hI, hc, heq⟩ := hsol.integral
    refine ⟨I, fun t ht x => ?_, hc, fun t ht x => ?_⟩
    · obtain ⟨g, hg, hIg⟩ := hI t ht x
      exact ⟨g, hg, hIg⟩
    · refine (ae_eq_dirac (notAdaptedField t x)).trans ?_
      refine Filter.EventuallyEq.trans ?_ (heq t ht x)
      exact Filter.Eventually.of_forall fun ω => by simp [notAdaptedField, J0]

/-- Negative fixture: `notAdaptedField` is not a solution, because it is not adapted. -/
theorem not_isRandomFieldSolution_notAdapted :
    ¬ IsRandomFieldSolution (F := trivialFiltration)
      (0 : PredL2 trivialFiltration (Measure.dirac true) →L[ℝ] Lp ℝ 2 (Measure.dirac true))
      1 (fun _ => 0) 0 notAdaptedField := by
  intro hu
  have hs := hu.adapted 1 one_pos 0 (measurableSet_singleton 0)
  rw [trivialFiltration, Filtration.const_apply] at hs
  rcases MeasurableSpace.measurableSet_bot_iff.1 hs with h1 | h1
  · have htrue : true ∈ notAdaptedField 1 0 ⁻¹' {0} := by simp [notAdaptedField]
    rw [h1] at htrue
    exact htrue
  · have hfalse : false ∈ notAdaptedField 1 0 ⁻¹' {0} := h1 ▸ mem_univ _
    simp [notAdaptedField] at hfalse

end ChenDalang15.Stoch

